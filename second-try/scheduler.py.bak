"""Short Order scheduler, v3.

Changes from v2, each behind a named constant so it can be swept or switched
off on its own (see TUNABLES):

  1. Ranking inside a tier is Smith's rule for the slowdown component:
     remaining work x max(span, bound), divided by an aging factor. Fairness
     (Jain over slowdowns) is what the aging term is for.
  2. Orders can be promoted a tier by age (AGE_PROMOTE), and cheap orders that
     are close to their deadline jump to the front (RESCUE_*).
  3. Preemption is back, but only when this inequality holds (a = running,
     b = candidate, p = cook time until the next oven step, span = work + oven,
     gain = min(p_a, ticks until some other cook comes free anyway)):
         gain / span_b  >  (1 + margin) * ((p_b + 2*switch_cost) / span_a
                                           + switch_cost/cores * sum(1/span_j over the rest of the rail))
     It cannot ping-pong: if a is preempted for b, b cannot be preempted for a.
     It also refuses to preempt an order that the preemption would doom.
  4. The first-slice rule (unstarted orders get a short turn) no longer needs
     the newcomer to be shorter than the running order.
  5. Blind estimates are cumulative per-step-label means from obs.history
     (durations are stationary within a run), including oven waits.
  6. schedule() cannot raise: on any error it falls back to a plain legal
     decision and counts it. A raise costs a decision; 20 in a row forfeits.
"""

import sys

from kitchen import Decision, Scheduler

# --------------------------------------------------------------------------
# TUNABLES. Change one at a time and re-run `compare`.
# --------------------------------------------------------------------------
LAMBDA = 0.5                # aging strength in the rank key; 0 turns aging off
AGE_PROMOTE = 3.0           # projected slowdown that promotes an order a tier
TIER0_MAX = 5               # remaining work <= this -> tier 0
TIER1_MAX = 15              # remaining work <= this -> tier 1 (else tier 2)
RESCUE_SLACK = 0           # viable order with 0 <= slack < this jumps the queue; 0 = off
RESCUE_MAX_REM = 15         # ...but only if it needs this little work (cheap to save)
PRIORITY_WEIGHT = 50.0      # priority only breaks ties (it is not scored)
IO_BURST_MAX = 100          # bursts up to this long that lead into an oven step get the factor below
IO_FACTOR = 0.5            # rank-key multiplier for those orders (1.0 = no oven preference)

PREEMPT_ENABLED = True
PREEMPT_MARGIN = 2.0       # hysteresis on the preemption inequality (sweep 1, 2, 4)
PREEMPT_MIN_RUN = 1         # ticks a cook must have worked before it can be taken off
PREEMPT_CANDIDATES = 6      # how many top-ranked waiting orders are considered

FIRST_SLICE_QUANTUM = 4     # ticks a cook works before an unstarted order may cut in
FIRST_SLICE_SC_LIMIT = 1    # first-slice rule runs when switch_cost <= this (or sparse)
FIRST_SLICE_ANY_SIZE = True # newcomer may be longer than the running order

RR_QUANTUM_MIN = 60         # sparse profiles: rotate cooks that have run this long
RR_QUANTUM_PER_SC = 20

REEVAL_ENABLED = True       # non-sparse: wake periodically while orders wait
REEVAL_MIN = 5
REEVAL_PER_SC = 3

BLIND_DOOM_FACTOR = 0.85    # blind: only call an order doomed if 85% of the estimate still fails


class MyScheduler(Scheduler):
    name = "my_scheduler"
    version = "3"

    def __init__(self):
        self.reset(0)

    def reset(self, seed):
        self._seen = set()      # history ids already folded into the estimates
        self._rs = {}           # recipe -> [n, sum of total work]
        self._ls = {}           # (recipe, step label) -> [n, sum of duration]
        self._pc = {}           # per-decision cache of order profiles
        self._errors = 0
        self._last_error = None

    def on_run_end(self, result):
        if self._errors:
            sys.stderr.write("my_scheduler: %d decision(s) used the fallback; last error: %s\n"
                             % (self._errors, self._last_error))

    # ---- estimation --------------------------------------------------------

    def _update_history(self, obs):
        """Fold newly served orders into cumulative means (blind profiles only).

        obs.history is a sliding window of the last 60, so entries are tracked
        by id. Durations are stationary within a run (the per-recipe stretch is
        drawn once), so a cumulative mean beats an exponential average.
        """
        if obs.kitchen.known_durations:
            return
        for h in obs.history:
            if h.id in self._seen:
                continue
            self._seen.add(h.id)
            r = self._rs.setdefault(h.recipe, [0, 0.0])
            r[0] += 1
            r[1] += h.total_work
            for label, _kind, dur in h.steps:
                if dur is None:
                    continue
                e = self._ls.setdefault((h.recipe, label), [0, 0.0])
                e[0] += 1
                e[1] += dur

    def _lm(self, recipe, label):
        e = self._ls.get((recipe, label))
        return e[1] / e[0] if e and e[0] else None

    def _estimate(self, obs, o):
        """Coarse work remaining: exact when shown, else recipe mean minus done."""
        if o.work_remaining is not None:
            return float(o.work_remaining)
        e = self._rs.get(o.recipe)
        if e and e[0]:
            return max(1.0, e[1] / e[0] - o.work_done)
        return obs.estimate_remaining(o)

    def _progress(self, o):
        """Cook ticks already spent inside the current step (blind only)."""
        done = 0.0
        for j in range(o.step):
            s = o.steps[j]
            if s.kind == "work" and s.duration is not None:
                done += s.duration
        return max(0.0, o.work_done - done)

    def _prof(self, obs, o):
        """(rem, burst, wait, switches_after_oven, span, has_wait) for an order.

        rem    cook ticks still needed
        burst  cook ticks until it next goes in the oven (or finishes)
        wait   oven ticks still ahead
        span   work + oven for the whole order (what slowdown divides by)
        """
        hit = self._pc.get(o.id)
        if hit is not None:
            return hit
        steps = o.steps
        i0 = o.step
        n = len(steps)
        rem = burst = wait = 0.0
        sw = 0
        in_burst = True
        after_wait = False
        has_wait = False
        complete = True
        prog = None
        for j in range(i0, n):
            s = steps[j]
            r = s.remaining
            if r is None:
                m = self._lm(o.recipe, s.label)
                if m is None:
                    complete = False
                    r = 0.0
                elif j == i0:
                    if prog is None:
                        prog = self._progress(o)
                    r = max(1.0, m - prog)
                else:
                    r = m
            if s.kind == "wait":
                has_wait = True
                wait += r
                in_burst = False
                after_wait = True
            else:
                rem += r
                if in_burst:
                    burst += r
                if after_wait:
                    sw += 1
                    after_wait = False
        if not complete:
            est = self._estimate(obs, o)
            rem = est
            burst = est if burst <= 0 else min(burst, est)
        span = 0.0
        ok = True
        for s in steps:
            d = s.duration
            if d is None:
                d = self._lm(o.recipe, s.label)
                if d is None:
                    ok = False
                    break
            span += d
        if not ok:
            span = o.work_done + rem + wait
        prof = (rem, burst, wait, sw, span, has_wait)
        self._pc[o.id] = prof
        return prof

    # ---- feasibility -------------------------------------------------------

    def _is_doomed(self, obs, o):
        """True if the order cannot finish before its deadline."""
        rem, _burst, wait, sw, _span, _hw = self._prof(obs, o)
        sc = obs.kitchen.switch_cost
        need = rem + wait + sw * sc
        if o.work_remaining is None:
            need *= BLIND_DOOM_FACTOR
        if o.is_running and o.core is not None:
            core = obs.core(o.core)
            if core is not None:
                if core.is_working:
                    return need > o.time_left
                if core.is_switching:
                    return need + core.switch_remaining > o.time_left
        return need + sc > o.time_left

    # ---- ranking -----------------------------------------------------------

    def _rank(self, obs, o):
        """Sort key for a waiting order; lower is served first."""
        rem, burst, wait, sw, span, has_wait = self._prof(obs, o)
        sc = obs.kitchen.switch_cost
        span_b = max(span, obs.kitchen.slowdown_bound)
        age = obs.time - o.arrival
        ratio = max(1.0, (age + rem + wait) / span_b)   # slowdown if served right now

        tier = 2
        if rem <= TIER0_MAX:
            tier = 0
        elif rem <= TIER1_MAX:
            tier = 1
        if ratio >= 2.0 * AGE_PROMOTE:
            tier = 0
        elif ratio >= AGE_PROMOTE and tier > 0:
            tier -= 1

        slack = o.time_left - (rem + wait + sw * sc) - sc
        if RESCUE_SLACK > 0 and rem <= RESCUE_MAX_REM and 0 <= slack < RESCUE_SLACK:
            tier = -1

        # Smith's rule for sum(turnaround / span), with aging for evenness.
        value = rem * span_b / (1.0 + LAMBDA * (ratio - 1.0))

        # Will its next step walk into a station that stays full?
        bump = 0
        steps = o.steps
        idx = o.step + 1
        if idx < len(steps):
            nxt = steps[idx]
            if nxt.station is not None:
                stn = obs.station(nxt.station)
                if stn is not None and stn.is_full:
                    cs = steps[o.step]
                    my_rem = cs.remaining if cs.remaining is not None else burst
                    min_h = None
                    for cid in stn.cores:
                        h = obs.order_on(cid)
                        if h is None or h.step >= len(h.steps):
                            continue
                        hs = h.steps[h.step]
                        hr = hs.remaining if hs.remaining is not None else self._prof(obs, h)[1]
                        if min_h is None or hr < min_h:
                            min_h = hr
                    if min_h is not None and min_h > my_rem:
                        bump = 1

        # Orders whose current burst leads into the oven free their cook early.
        # A factor (not an absolute first place) keeps them from jumping
        # shorter orders that have no oven step.
        if has_wait and burst <= IO_BURST_MAX:
            value *= IO_FACTOR
        return (tier, bump, value, slack - (o.priority - 1) * PRIORITY_WEIGHT)

    # ---- profile shape -----------------------------------------------------

    def _is_sparse(self, obs):
        """True if no recipe on the menu has an oven step (events are rare)."""
        for r in obs.recipes.values():
            for _label, kind, _ticks in r.steps:
                if kind == "wait":
                    return False
        return True

    # ---- decision phases ---------------------------------------------------

    def _take(self, decision, obs, core, cur, cand, free, a_cores, a_orders):
        """Put cand on core (taking cur off it) and keep the bookkeeping."""
        decision.assign(core, cand)
        a_cores.add(core.id)
        a_orders.add(cand.id)
        if cand.station is not None:
            free[cand.station] = free.get(cand.station, 0) - 1
        if cur is not None and cur.station is not None:
            free[cur.station] = free.get(cur.station, 0) + 1

    def _station_ok(self, cand, cur, free):
        st = cand.station
        if st is None:
            return True
        bonus = 1 if (cur is not None and cur.station == st) else 0
        return free.get(st, 0) + bonus > 0

    def _free_in(self, obs, decision, core):
        """Ticks until this cook is next available, counting this decision."""
        sc = obs.kitchen.switch_cost
        asg = decision.assignments
        if core.id in asg:
            oid = asg[core.id]
            if oid is None:
                return 0.0
            o = obs.order(oid)
            if o is not None and oid != core.order:
                return sc + self._prof(obs, o)[1]
        if core.order is None:
            return 0.0
        o = obs.order_on(core)
        if o is None:
            return 0.0
        return self._prof(obs, o)[1] + (core.switch_remaining if core.is_switching else 0)

    def _preempt(self, obs, decision, rest, free, a_cores, a_orders):
        """Take a cook off its order when the inequality in the docstring holds."""
        sc = obs.kitchen.switch_cost
        bound = obs.kitchen.slowdown_bound
        cands = rest[:PREEMPT_CANDIDATES]
        if not cands:
            return
        scored = []
        for core in obs.working_cores:
            if core.id in a_cores or core.running_for < PREEMPT_MIN_RUN:
                continue
            cur = obs.order_on(core)
            if cur is None:
                continue
            scored.append((-self._prof(obs, cur)[1], core.id, core, cur))
        scored.sort(key=lambda t: (t[0], t[1]))   # cook with the most to gain first
        for _neg, _cid, core, cur in scored:
            if not cands:
                break
            rem_a, burst_a, wait_a, sw_a, span_a, _hw = self._prof(obs, cur)
            if burst_a <= 2 * sc or self._is_doomed(obs, cur):
                continue
            span_a = max(span_a, bound)
            need_a = rem_a + wait_a + sw_a * sc
            # Another cook may come free soon and take the candidate anyway; the
            # waiting we would save is then only that long, not burst_a.
            others = [self._free_in(obs, decision, c) for c in obs.cores if c.id != core.id]
            gain = burst_a if not others else min(burst_a, min(others))
            for cand in cands:
                # The extra switch also costs every other waiting order about
                # switch_cost / cores ticks of lost capacity.
                rail_w = 0.0
                for j in rest:
                    if j is not cand:
                        rail_w += 1.0 / max(self._prof(obs, j)[4], bound)
                _r, burst_b, _w, _s, span_b, _h = self._prof(obs, cand)
                span_b = max(span_b, bound)
                burst_b = max(burst_b, 1.0)
                cost = (burst_b + 2 * sc) / span_a + (sc / max(1, len(obs.cores))) * rail_w
                if gain / span_b <= (1.0 + PREEMPT_MARGIN) * cost:
                    continue
                if need_a + burst_b + 2 * sc > cur.time_left:
                    continue            # this preemption would doom the running order
                if not self._station_ok(cand, cur, free):
                    continue
                self._take(decision, obs, core, cur, cand, free, a_cores, a_orders)
                cands.remove(cand)
                if cand in rest:
                    rest.remove(cand)
                break

    def _first_slice(self, obs, decision, viable, free, a_cores, a_orders):
        """Give unstarted orders a short first turn so response stays low."""
        sc = obs.kitchen.switch_cost
        unstarted = [o for o in viable if o.id not in a_orders and not o.has_started]
        quantum = max(sc * 2, FIRST_SLICE_QUANTUM)
        for core in sorted(obs.working_cores, key=lambda c: -c.running_for):
            if not unstarted:
                break
            if core.id in a_cores:
                continue
            if core.running_for < quantum:
                break
            cur = obs.order_on(core)
            if cur is None:
                continue
            cur_rem = self._prof(obs, cur)[0]
            if cur_rem <= max(sc, quantum):
                continue                # it will be done within a slice anyway
            for o in unstarted:
                if not FIRST_SLICE_ANY_SIZE and cur_rem <= self._prof(obs, o)[0]:
                    continue
                if not self._station_ok(o, cur, free):
                    continue
                self._take(decision, obs, core, cur, o, free, a_cores, a_orders)
                unstarted.remove(o)
                break

    def _rotate(self, obs, decision, viable, free, a_cores, a_orders, quantum):
        """Sparse profiles: slowly rotate cooks that have run a long time."""
        sc = obs.kitchen.switch_cost
        waiting = [o for o in viable if o.id not in a_orders]
        for core in sorted(obs.working_cores, key=lambda c: -c.running_for):
            if not waiting:
                break
            if core.id in a_cores:
                continue
            if core.running_for < quantum:
                break
            cur = obs.order_on(core)
            if cur is None:
                continue
            cur_rem = self._prof(obs, cur)[0]
            if cur_rem <= sc:
                continue
            for o in waiting:
                if cur_rem <= self._prof(obs, o)[0]:
                    continue
                if not self._station_ok(o, cur, free):
                    continue
                self._take(decision, obs, core, cur, o, free, a_cores, a_orders)
                waiting.remove(o)
                break

    # ---- schedule ----------------------------------------------------------

    def schedule(self, obs):
        try:
            return self._schedule(obs)
        except Exception as exc:  # a raise would cost the decision; fall back instead
            self._errors += 1
            self._last_error = "%s: %s" % (type(exc).__name__, exc)
            return self._fallback(obs)

    def _fallback(self, obs):
        decision = Decision()
        free = obs.free_stations()
        taken = set()
        for core in obs.idle_cores:
            for o in obs.ready:
                if o.id in taken:
                    continue
                st = o.station
                if st is not None and free.get(st, 0) <= 0:
                    continue
                decision.assign(core, o)
                taken.add(o.id)
                if st is not None:
                    free[st] -= 1
                break
        return decision.annotate(text="FALLBACK: %s" % self._last_error)

    def _schedule(self, obs):
        self._pc = {}
        self._update_history(obs)

        decision = Decision()
        sc = obs.kitchen.switch_cost
        sparse = self._is_sparse(obs)
        rr_quantum = max(sc * RR_QUANTUM_PER_SC, RR_QUANTUM_MIN)

        # ===== TRIAGE =====
        viable, doomed = [], []
        for o in obs.ready:
            (doomed if self._is_doomed(obs, o) else viable).append(o)
        viable.sort(key=lambda o: self._rank(obs, o))
        rail = viable + doomed

        # ===== ASSIGN IDLE COOKS =====
        free = obs.free_stations()
        a_orders = set()
        a_cores = set()
        for core in obs.idle_cores:
            for order in rail:
                if order.id in a_orders:
                    continue
                st = order.station
                if st is not None and free.get(st, 0) <= 0:
                    continue
                if order in doomed and viable:
                    continue
                decision.assign(core, order)
                a_orders.add(order.id)
                if st is not None:
                    free[st] -= 1
                break

        rest = [o for o in viable if o.id not in a_orders]

        # ===== PREEMPT: doomed running orders =====
        for core in obs.working_cores:
            cur = obs.order_on(core)
            if cur is None or not self._is_doomed(obs, cur):
                continue
            for cand in rest:
                if self._station_ok(cand, cur, free):
                    self._take(decision, obs, core, cur, cand, free, a_cores, a_orders)
                    rest.remove(cand)
                    break

        # ===== PREEMPT: the inequality =====
        if PREEMPT_ENABLED:
            self._preempt(obs, decision, rest, free, a_cores, a_orders)

        # ===== FIRST SLICE / ROTATION =====
        if (sparse or sc <= FIRST_SLICE_SC_LIMIT) and obs.working_cores:
            self._first_slice(obs, decision, viable, free, a_cores, a_orders)
        if sparse and obs.working_cores:
            self._rotate(obs, decision, viable, free, a_cores, a_orders, rr_quantum)

        # ===== TIMER =====
        wake = None
        unstarted = [o for o in obs.ready if o.id not in a_orders and not o.has_started]
        if unstarted and (sparse or sc <= FIRST_SLICE_SC_LIMIT):
            active_quantum = max(sc * 2, FIRST_SLICE_QUANTUM)
        else:
            active_quantum = rr_quantum if sparse else None
        if active_quantum is not None:
            if obs.working_cores:
                max_run = max(c.running_for for c in obs.working_cores)
                wake = max(1, active_quantum - max_run)
            elif obs.busy_cores:
                max_sw = max(c.switch_remaining for c in obs.busy_cores)
                wake = max(1, max_sw + active_quantum)
            else:
                wake = active_quantum

        soonest = None
        for o in obs.orders:
            if not o.is_blocked and (soonest is None or o.time_left < soonest):
                soonest = o.time_left
        if soonest is not None and soonest > 1:
            dl = max(1, soonest - sc - 2)
            wake = dl if wake is None else min(wake, dl)

        if REEVAL_ENABLED and not sparse and rest and obs.busy_cores:
            q = max(REEVAL_MIN, sc * REEVAL_PER_SC)
            wake = q if wake is None else min(wake, q)

        if wake is not None:
            decision.wake_in(wake)

        return decision.annotate(
            text="t=%d v=%d d=%d i=%d b=%d" % (obs.time, len(viable), len(doomed),
                                               len(obs.idle_cores), len(obs.busy_cores)),
            queue=[o.id for o in rail],
        )
